{
  "name": "Daily Full Google Drive Backup (All Companies)",
  "description": "Runs every night at 2am ET \u2014 backs up all patient records, clinical history, pharmacy sales, staff, billing, and audit logs to Google Drive, organized by date folder per company.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
