{
  "name": "Google Drive Backup - Every 12 Hours",
  "description": "Automatically backup all active companies to Google Drive every 12 hours. Deletes old backups and keeps only the latest.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 12,
      "interval_unit": "hours",
      "interval_anchor": "2026-02-08T18:13:17.850000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "google_drive_backup_every_12_hours",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "backupAllCompaniesToGoogleDrive",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "backupAllCompaniesToGoogleDrive"
  }
}